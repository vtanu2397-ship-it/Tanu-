rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Student profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().id == userId
        && incoming().email is string
        && incoming().email.size() <= 256;
      allow update: if isOwner(userId)
        && incoming().id == existing().id;
      allow delete: if isOwner(userId);

      // Student assessments subcollection
      match /assessments/{assessmentId} {
        allow get: if isOwner(userId) && isValidId(assessmentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assessmentId)
          && incoming().studentId == userId
          && incoming().id == assessmentId;
        allow update: if isOwner(userId) && isValidId(assessmentId)
          && incoming().studentId == existing().studentId;
        allow delete: if isOwner(userId) && isValidId(assessmentId);
      }

      // Student roadmaps subcollection
      match /roadmaps/{roadmapId} {
        allow get: if isOwner(userId) && isValidId(roadmapId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(roadmapId)
          && incoming().studentId == userId
          && incoming().id == roadmapId;
        allow update: if isOwner(userId) && isValidId(roadmapId)
          && incoming().studentId == existing().studentId;
        allow delete: if isOwner(userId) && isValidId(roadmapId);
      }

      // Student mock interviews subcollection
      match /interviews/{interviewId} {
        allow get: if isOwner(userId) && isValidId(interviewId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(interviewId)
          && incoming().studentId == userId
          && incoming().id == interviewId;
        allow update: if isOwner(userId) && isValidId(interviewId)
          && incoming().studentId == existing().studentId;
        allow delete: if isOwner(userId) && isValidId(interviewId);
      }
    }
  }
}
